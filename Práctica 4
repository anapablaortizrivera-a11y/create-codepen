<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TeotiFly | Reservas</title>
<link rel="stylesheet" href="assets/css/styles.css">
</head>
<body>
<nav class="menu-principal">
<ul>
<li><a href="index.html">Inicio</a></li>
<li><a href="paquetes.html">Paquetes</a></li>
<li><a href="reservas.html" class="activo">Reservas</a></li>
</ul>
</nav>
<main class="contenedor-principal">
<h1 class="titulo-seccion">Formulario de Reservación</h1>
<form class="formulario-reserva">
<label for="nombre">Nombre completo:</label>
<input type="text" id="nombre" name="nombre" required placeholder="Escribe tu
nombre">
<label for="correo">Correo electrónico:</label>
<input type="email" id="correo" name="correo" required
placeholder="correo@ejemplo.com">
<label for="paquete">Selecciona el paquete:</label>
<select id="paquete" name="paquete">
<option value="tradicional">Vuelo Tradicional</option>
<option value="pareja">Vuelo Privado Pareja</option>
<option value="familiar">Vuelo Familiar</option>
<option value="desayuno">Vuelo con Desayuno</option>
<option value="amigos">Vuelo Entre Amigos</option>
<option value="vip">Vuelo VIP Todo Incluido</option>
</select>
<label for="fecha">Fecha del vuelo:</label>
<input type="date" id="fecha" name="fecha" required>
<button type="submit" class="boton-enviar">Enviar Reserva</button>
</form>
</main>
<footer>
<p>CETIS N° 141 - Submódulo 1: Construye Aplicaciones Web</p>
</footer>
</body>
</html>
